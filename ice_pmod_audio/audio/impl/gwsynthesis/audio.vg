module top (
  clk,
  pmod_audio
)
;
input clk;
output pmod_audio;
wire clk_d;
wire cnt_4_9;
wire pmod_audio_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  OBUF pmod_audio_obuf (
    .O(pmod_audio),
    .I(pmod_audio_d) 
);
  por_reset u_por (
    .clk_d(clk_d),
    .cnt_4_9(cnt_4_9)
);
  jingle_player u_jingle (
    .clk_d(clk_d),
    .cnt_4_9(cnt_4_9),
    .pmod_audio_d(pmod_audio_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
