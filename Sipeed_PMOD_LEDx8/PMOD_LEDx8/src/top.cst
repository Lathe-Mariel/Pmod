// =============================================================
// 物理制約ファイル (.cst)
// Board    : Tang Primer 25K Dock (GW5A-LV25MG121NES)
// PMOD     : Sipeed PMOD_LEDx8
//            (Pmod_LCD096 / Sipeed_POMD_DTx2 と同じ G11,D11,B11,C11 / G10,D10,B10,C10 のポートに接続)
//
// ■ Pmod ピンと LED の対応 (Pmod_DS2 の pmod_led 割り当てに準拠):
//   LED  : L1   L2   L3   L4   L5   L6   L7   L8
//   ボール: C10  C11  B10  B11  D10  D11  G10  G11
//   PMOD_LEDx8 は L1,L3,L5,L7 と L2,L4,L6,L8 がそれぞれ別の列に並ぶため,
//   上下の列を交互に使う割り当てになっている.
//
// ■ その他:
//   sys_clk  (50MHz)          : E2
//   reset    (S1, 押下で High) : H10
//   mode_btn (S2, 押下で High) : H11
// =============================================================

// ----------------------------------------------------------
// システムクロック / ボタン
// ----------------------------------------------------------
IO_LOC "sys_clk" E2;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "reset" H10;
IO_PORT "reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "mode_btn" H11;
IO_PORT "mode_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// ----------------------------------------------------------
// PMOD_LEDx8 (アクティブLow)
// ----------------------------------------------------------
IO_LOC "led_n[0]" C10;   // L1
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[1]" C11;   // L2
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[2]" B10;   // L3
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[3]" B11;   // L4
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[4]" D10;   // L5
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[5]" D11;   // L6
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[6]" G10;   // L7
IO_PORT "led_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_n[7]" G11;   // L8
IO_PORT "led_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
